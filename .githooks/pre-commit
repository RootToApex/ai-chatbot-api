#!/bin/bash
# 시크릿 커밋 차단 — 이번 커밋에 "추가되는 내용"과 "추가되는 파일명"을 검사한다.
# 설치: git config core.hooksPath .githooks  (start.sh가 자동으로 함)
# 원칙: 권고는 문서로, 금지는 훅으로. 여기서 걸리면 커밋 자체가 안 된다.
#
# 08-09 보강: ①추가 라인이 0개인 커밋(삭제만)이 pipefail로 오차단되던 버그 수정
#            ②diff-filter에 R(rename) 포함  ③.env.* 파일명 일반화(.env.test 등)

set -uo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
RED=$'\033[31m'; YEL=$'\033[33m'; BOLD=$'\033[1m'; OFF=$'\033[0m'
FAIL=0

# ── 1) 파일명 기반 차단 ────────────────────────────────────────────────
# .env 및 .env.<아무접미사>는 전부 후보 → example/sample/template만 예외
CAND=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei \
  '(^|/)\.env(\.[A-Za-z0-9._-]+)?$|\.pem$|\.p12$|\.pfx$|\.jks$|\.keystore$|(^|/)id_rsa|(^|/)id_ed25519|\.key$|(^|/)credentials(\.json)?$|(^|/)service-account.*\.json$' \
  || true)
BLOCKED=$(printf '%s\n' "$CAND" | grep -Ev '(^|/)\.env\.(example|sample|template)$' | grep -v '^$' || true)

if [ -n "$BLOCKED" ]; then
  echo ""
  echo "${RED}${BOLD}🚨 커밋 차단 — 커밋하면 안 되는 파일이 스테이징됐습니다${OFF}"
  echo "$BLOCKED" | sed 's/^/    /'
  echo "  해결: ${BOLD}git restore --staged <파일>${OFF} 후 .gitignore 확인"
  FAIL=1
fi

# ── 2) 내용 기반 차단 (추가되는 라인만) ───────────────────────────────
# 훅 스크립트 자신은 제외 — 패턴 정의(AKIA…, sk-… 예시)가 들어 있어 자기 자신에 걸린다
# 추가 라인이 0개면(삭제·rename만) 스캔을 건너뛴다 — grep 무매치가 실패로 전파되던 버그의 수정
ADDED=$(git diff --cached --diff-filter=ACMR -U0 -- . ':(exclude).githooks/*' \
        | grep -E '^\+' | grep -Ev '^\+\+\+' || true)
if [ -n "$ADDED" ]; then
  if ! printf '%s\n' "$ADDED" | bash "$DIR/secret-scan.sh" "커밋"; then
    FAIL=1
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "${YEL}환경변수로 빼세요.${OFF} 코드에도 문서에도 실제 값은 쓰지 않습니다."
  echo "  application.yml →  \${AI_API_KEY}   /  실제 값은 .env(gitignore됨)에"
  echo ""
  echo "${YEL}오탐이라고 판단되면 임의로 우회하지 말고 사용자에게 보고 → 승인 후 진행.${OFF}"
  echo "  (--no-verify는 에이전트 가드가 차단하며, 넘겨도 pre-push에서 다시 잡힙니다)"
  echo ""
  exit 1
fi
exit 0
