# 값을 채워 .env로 복사해서 씁니다 (cp .env.example .env)
# .env는 커밋되지 않습니다. 아래 DB 값은 비워도 compose.yml·application.yml의 기본값으로 로컬 실행이 됩니다.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# AI provider — openai(기본, 실제 호출) 또는 fake(키 없이 흐름만 시연)
AI_PROVIDER=
# 실제 호출에 필요합니다. 없으면 대화 생성 API가 503을 반환합니다.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_TIMEOUT_SECONDS=

# 미설정 시 기동할 때 임의 서명 키를 생성합니다 (재기동하면 기존 토큰 무효)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=

# 관리자 시드 계정 (미설정 시 admin@example.com / admin1234)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM에 함께 보낼 최근 대화 수 / 스레드 유휴 경계(분)
CHAT_HISTORY_SIZE=
CHAT_THREAD_IDLE_MINUTES=

# Spring Boot는 이 파일을 자동으로 읽지 않습니다. 셸에 주입해서 실행하세요:
#   set -a && . ./.env && set +a && ./gradlew bootRun
